<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="完全离线的 LeetCode 热题 100 Python 学习与评测工具">
  <title>Hot 100 · Python 离线训练场</title>
  <style>__STYLES__</style>
</head>
<body>
  <div id="storage-warning" class="storage-warning">当前浏览器未允许本地存储；本次内容仅保存在内存中，请及时导出 Markdown 备份。</div>

  <header class="app-header">
    <div class="brand" role="banner">
      <div class="brand-mark" aria-hidden="true">H100</div>
      <div class="brand-copy">
        <div class="brand-title">Python 离线训练场</div>
        <div class="brand-subtitle">LeetCode 热题 100 · 题面、评测、题解与笔记</div>
      </div>
    </div>
    <div class="header-actions">
      <div class="offline-pill" title="所有题面、图片、运行时和评测数据均已内嵌">
        <span class="offline-dot"></span><span>完全离线</span>
      </div>
      <button id="import-button" class="button" type="button" title="导入 Markdown 学习记录"><span aria-hidden="true">↥</span> <span class="header-action-label">导入</span></button>
      <button id="export-button" class="button" type="button" title="导出 Markdown 学习记录"><span aria-hidden="true">↧</span> <span class="header-action-label">导出</span></button>
      <button id="theme-button" class="icon-button" type="button" aria-label="切换深色模式" title="切换明暗主题">◐</button>
    </div>
  </header>

  <main>
    <section id="catalog-view" class="view active" aria-label="题目目录">
      <div class="catalog-shell">
        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Offline Algorithm Lab</p>
            <h1>把 100 道经典题，练成你的肌肉记忆。</h1>
            <p class="hero-description">一个文件，完整题面、本地 Python 评测、参考题解和个人 Markdown 笔记全部随身携带。无需账号，也无需网络。</p>
            <div class="hero-actions">
              <button id="continue-button" class="button primary" type="button">继续上次练习</button>
              <button id="random-button" class="button secondary" type="button">随机一道未完成题</button>
            </div>
          </div>
          <div id="progress-orbit" class="progress-orbit" aria-label="总体完成进度">
            <div class="progress-value"><span id="progress-number" class="progress-number">0%</span><span class="progress-label">总体进度</span></div>
          </div>
        </section>

        <section class="summary-grid" aria-label="学习统计">
          <article class="summary-card"><div class="summary-label">已通过</div><div class="summary-value"><span id="solved-count">0</span><span class="summary-suffix">/ 100</span></div></article>
          <article class="summary-card"><div class="summary-label">进行中</div><div class="summary-value"><span id="attempted-count">0</span><span class="summary-suffix">道</span></div></article>
          <article class="summary-card"><div class="summary-label">个人笔记</div><div class="summary-value"><span id="noted-count">0</span><span class="summary-suffix">篇</span></div></article>
          <article class="summary-card"><div class="summary-label">累计提交</div><div class="summary-value"><span id="submission-count">0</span><span class="summary-suffix">次</span></div></article>
        </section>

        <section class="catalog-toolbar" aria-label="目录筛选">
          <label class="search-field"><span class="hidden">搜索题目</span><input id="search-input" type="search" placeholder="搜索题号、题名、专题或标签…" autocomplete="off"></label>
          <select id="difficulty-filter" class="select-field" aria-label="按难度筛选">
            <option value="all">全部难度</option><option value="Easy">简单</option><option value="Medium">中等</option><option value="Hard">困难</option>
          </select>
          <select id="status-filter" class="select-field" aria-label="按状态筛选">
            <option value="all">全部状态</option><option value="todo">未开始</option><option value="attempted">进行中</option><option value="solved">已通过</option><option value="noted">有笔记</option>
          </select>
          <button id="clear-filter-button" class="button ghost" type="button">清除筛选</button>
        </section>

        <div id="category-grid" class="category-grid"></div>
        <footer class="catalog-footer">题单快照：2026-08-23 · 题面版权归 LeetCode 及原作者 · Python 运行时：Pyodide 314.0.4（MPL-2.0）与 CPython</footer>
      </div>
    </section>

    <section id="study-view" class="view study-view" aria-label="刷题工作区">
      <div class="study-toolbar">
        <div class="study-nav">
          <button id="back-button" class="button ghost" type="button">← 返回目录</button>
          <span id="study-position" class="study-position">1 / 100</span>
          <span id="study-title-mini" class="study-title-mini"></span>
        </div>
        <div class="study-actions">
          <button id="previous-button" class="icon-button" type="button" aria-label="上一题" title="上一题">‹</button>
          <button id="next-button" class="icon-button" type="button" aria-label="下一题" title="下一题">›</button>
          <button id="mastered-button" class="button ghost" type="button">标记已掌握</button>
        </div>
      </div>

      <div class="study-layout">
        <article id="problem-pane" class="problem-pane">
          <div class="problem-content">
            <div id="problem-kicker" class="problem-kicker"></div>
            <h1 id="problem-title"></h1>
            <div id="official-content" class="official-content"></div>
            <div class="source-note">题面来自力扣 LeetCode 热题 100 学习计划的离线快照，仅用于个人学习。网页中的本地评测是练习辅助，不等同于力扣官方判题。</div>
          </div>
        </article>

        <section class="workspace-pane" aria-label="代码与笔记">
          <nav class="workspace-tabs" aria-label="工作区标签">
            <button class="tab-button active" type="button" data-tab="code">Python 代码</button>
            <button class="tab-button" type="button" data-tab="notes">个人笔记</button>
            <button class="tab-button" type="button" data-tab="solution">参考题解</button>
          </nav>

          <div id="code-panel" class="workspace-panel active">
            <div class="editor-toolbar">
              <div class="toolbar-group"><span class="language-pill">Python 3</span><span id="code-save-state" class="save-state">已保存</span></div>
              <div class="toolbar-group">
                <div class="font-control" aria-label="编辑器字号"><button id="font-down-button" type="button" aria-label="减小字号">−</button><span id="font-size-label">14</span><button id="font-up-button" type="button" aria-label="增大字号">＋</button></div>
                <button id="reset-code-button" class="button small ghost" type="button">重置模板</button>
              </div>
            </div>
            <textarea id="code-editor" class="code-editor" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Python 代码编辑器"></textarea>
            <div class="editor-statusbar"><span>Tab = 4 空格 · ⌘/Ctrl + Enter 运行样例</span><span id="cursor-position">Ln 1, Col 1</span></div>
            <div id="result-panel" class="result-panel"></div>
            <div class="runbar">
              <div id="runtime-status" class="runtime-status"><span class="offline-dot"></span><span>Python 运行时已内置，将自动准备</span></div>
              <div class="toolbar-group"><button id="run-button" class="button" type="button">运行样例</button><button id="submit-button" class="button primary" type="button">提交评估</button></div>
            </div>
          </div>

          <div id="notes-panel" class="workspace-panel">
            <div class="notes-toolbar"><div><strong>个人笔记</strong> <span id="notes-save-state" class="save-state">已保存</span></div><span class="save-state">支持 Markdown 原文</span></div>
            <div class="notes-empty-tip">记录易错点、复杂度、复盘结论或自己的解法。笔记会与代码和进度一起导出为 Markdown。</div>
            <textarea id="notes-editor" class="notes-editor" placeholder="# 我的思路\n\n- 核心状态：\n- 易错边界：\n- 复盘：" spellcheck="false" aria-label="个人 Markdown 笔记"></textarea>
          </div>

          <div id="solution-panel" class="workspace-panel">
            <div class="solution-toolbar"><strong>参考题解</strong><button id="copy-solution-button" class="button small" type="button">复制代码</button></div>
            <div class="solution-scroll"><div class="solution-section"><h2>解题思路</h2><div id="solution-note" class="solution-note"></div><div id="solution-complexity" class="complexity"></div><pre id="reference-code" class="reference-code"></pre><p class="solution-warning">建议先独立完成并提交评估，再展开参考实现对照。参考代码是本地评测的基准实现之一。</p></div></div>
          </div>
        </section>
      </div>
    </section>
  </main>

  <div id="export-modal" class="modal-overlay hidden" role="presentation">
    <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="export-modal-title">
      <div class="modal-icon" aria-hidden="true">↧</div>
      <h2 id="export-modal-title">导出 Markdown 清单</h2>
      <p>导出结果会以紧凑的任务列表为主，并保留进度和个人笔记，之后可以重新导入。</p>
      <label class="option-row" for="export-code-checkbox">
        <span><strong>同时导出个人代码</strong><small>仅包含保存过的代码；关闭后文件会更简洁。</small></span>
        <input id="export-code-checkbox" type="checkbox">
      </label>
      <div class="modal-actions">
        <button id="export-cancel-button" class="button ghost" type="button">取消</button>
        <button id="export-confirm-button" class="button primary" type="button">导出清单</button>
      </div>
    </section>
  </div>

  <input id="markdown-file-input" class="hidden" type="file" accept=".md,text/markdown,text/plain">
  <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

  <script>__APP_SCRIPT__</script>
</body>
</html>
